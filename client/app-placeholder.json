        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#121212"
      },
      "package": "com.anonymous.tldrnewsletter",
      "versionCode": 1
    },
    "plugins": [
      "expo-secure-store",
      "expo-status-bar"
    ],
    "platforms": [
      "android"
    ],
    "extra": {
      "eas": {
        "projectId": "ac929487-9bbd-452e-a962-19e6f9789c8f"
